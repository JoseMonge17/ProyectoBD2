-- Consulta para verificar los datos insertados
SELECT 
    c.nombre as cliente,
    c.genero,
    o.orden_id,
    o.fecha,
    o.canal,
    o.moneda,
    o.total,
    p.nombre as producto,
    p.sku,
    od.cantidad,
    od.precio_unit
FROM ventas_pg.orden o
JOIN ventas_pg.cliente c ON o.cliente_id = c.cliente_id
JOIN ventas_pg.orden_detalle od ON o.orden_id = od.orden_id
JOIN ventas_pg.producto p ON od.producto_id = p.producto_id
ORDER BY o.fecha;